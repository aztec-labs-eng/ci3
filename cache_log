#!/usr/bin/env bash
# Runs the given command.
# If a redis cache is available, redirect input into a cache log.
# If DUP=1 then we duplicate input also to stdout.
NO_CD=1 source $(dirname "${BASH_SOURCE[0]}")/source

name=$1

key=${2:-$(uuid)}
dup=${DUP:-0}
outfile=/tmp/$key
touch $outfile
trap 'rm -f $outfile' EXIT
if [ -n "${PARENT_LOG_ID:-}" ]; then
  echo -e "Parent Log: $(ci_term_link $PARENT_LOG_ID)" >>$outfile
else
  echo -e "Parent Log: none" >>$outfile
fi
echo -e "Started: $(date)" >>$outfile
echo -e "Completed: in-progress" >>$outfile
echo -e "Took: in-progress\n" >>$outfile

function finalize_log {
  # Use sed to update the header.
  sed -i "3c Completed: $(date)" "$outfile"
  sed -i "4c Took: ${SECONDS}s" "$outfile"
}

function publish_log {
  cat $outfile | log_publish $key $CI_REDIS_EXPIRE
}

function publish_log_final {
  finalize_log
  # Synchronous: this is the run's top-level log and the instance goes away right after.
  cat $outfile | CACHE_PERSIST_SYNC=1 cache_persistent $key $CI_REDIS_EXPIRE
}

# Publishes the log whenever it has changed, until $outfile.done appears. Stopped through that
# file rather than killed, so a publish in flight finishes before the final one and cannot land
# after it.
function live_publish_log {
  local interval=$(log_publish_interval) last=
  while [ ! -f $outfile.done ]; do
    local mtime=$(stat -c %Y "$outfile")
    if [ "$mtime" != "$last" ]; then
      publish_log
      last=$mtime
    fi
    for ((i = 0; i < interval; i++)); do
      [ -f $outfile.done ] && break
      sleep 1
    done
  done
}

if log_store_available; then
  trap 'rm -f $outfile $outfile.done' EXIT
  log_str="$name log id: ${yellow}$DASHBOARD_URL/$key${reset}"
  echo_stderr -e "$log_str"
  # Close inherited pipeline FDs to prevent blocking parent pipelines.
  # When cache_log runs inside a pipeline, fd 1/2 may reference the parent's pipe.
  # Holding them open prevents the parent pipeline from seeing EOF.
  exec 2>/dev/null
  if [ "$dup" -ne 1 ]; then
    exec >/dev/null
  fi
  live_publish_log >&- 2>&- &
  publish_pid=$!
  if [ "$dup" -eq 1 ]; then
    redact | tee -a $outfile
    # Print a second line if the log is long enough.
    # This is to avoid having to scroll up to see the log id.
    if [ "$(cat $outfile | wc -l)" -ge 16 ]; then
      echo_stderr -e "$log_str"
    fi
  else
    redact | cat >>$outfile
  fi
  touch $outfile.done
  wait $publish_pid
  publish_log_final
else
  if [ "$dup" -eq 1 ]; then
    redact | cat
  else
    cat >/dev/null
  fi
fi
