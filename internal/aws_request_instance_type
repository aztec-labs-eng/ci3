#!/usr/bin/env bash
source $(dirname "${BASH_SOURCE[0]}")/../source
source $(dirname "${BASH_SOURCE[0]}")/source_shutdown_timer

name=$1
ami=$2
state_dir=$3

# Space-separated "instanceType:priority" tokens describing the spot pools to
# diversify across (set by aws_request_instance).
overrides_spec=${FLEET_OVERRIDES:?FLEET_OVERRIDES must be set}

spec_path=$state_dir/lt_data.json
iid_path=$state_dir/iid
ip_path=$state_dir/ip
lt_path=$state_dir/launch_template_id
launch_id_path=$state_dir/launch_id

# Minutes an instance lives after boot if nobody claims it (see source_shutdown_timer). It must be longer
# than provisioning can take before the claim lands: up to 300 s waiting for SSM, then up to three claim
# attempts of 60 s each, 5 s apart, about 8 minutes in all.
AWS_BOOT_SHUTDOWN_TIME=${AWS_BOOT_SHUTDOWN_TIME:-15}
if ! [[ "$AWS_BOOT_SHUTDOWN_TIME" =~ ^[0-9]+$ ]] || [ "$AWS_BOOT_SHUTDOWN_TIME" -lt 10 ]; then
  echo_stderr "AWS_BOOT_SHUTDOWN_TIME must be a whole number of minutes, at least 10: $AWS_BOOT_SHUTDOWN_TIME"
  exit 1
fi

export AWS_DEFAULT_REGION=us-east-2

# Delete the ephemeral launch template. Safe once instances are launched (they
# no longer reference it) and idempotent, so we run it on every exit.
function delete_lt {
  [ -f "$lt_path" ] || return 0
  aws ec2 delete-launch-template --launch-template-id "$(cat "$lt_path")" >/dev/null 2>&1 || true
  rm -f "$lt_path"
}

# On interrupt, tear down whatever we acquired. On normal exit we only drop the
# launch template (the instance must survive for the caller).
function cleanup {
  delete_lt
  aws_terminate_instance "$state_dir"
}
trap 'cleanup' SIGINT SIGTERM
trap 'delete_lt' EXIT

# Instances get no key pair and a security group with no inbound rules: they are reached only through SSM.
if [ -n "${KEY_NAME:-}" ]; then
  echo_stderr "KEY_NAME is set, but build instances no longer take an SSH key pair; they are reached through SSM."
  exit 1
fi

# Always attach the instance profile so containers can use instance-profile credentials.
CI3_INSTANCE_PROFILE_NAME=${CI3_INSTANCE_PROFILE_NAME:-ci3-build-instance-profile}

sg_id="${CI3_SECURITY_GROUP_ID:-sg-01fe61a1c1aaeb393}"

# create-fleet spreads across AZs via subnet overrides, which must live in the
# same VPC as the security group. Pick one subnet per AZ.
vpc_id=$(aws ec2 describe-security-groups --group-ids "$sg_id" \
  --query 'SecurityGroups[0].VpcId' --output text)
mapfile -t subnets < <(aws ec2 describe-subnets \
  --filters "Name=vpc-id,Values=$vpc_id" \
  --query 'Subnets[].[AvailabilityZone,SubnetId]' --output text | sort -k1,1 -u | awk '{print $2}')
if [ "${#subnets[@]}" -eq 0 ]; then
  echo_stderr "No subnets found in VPC $vpc_id for security group $sg_id."
  exit 1
fi

# An id unique to this request. It names the launch template and is tagged on the instance as CI3LaunchId,
# so aws_terminate_instance can find the instance even if its instance id never came back to us. The name
# part is cut to 96 characters to keep the whole within the 128-character launch template name limit.
launch_id="ci3-${name:0:96}-$$-$(date +%s)-$RANDOM"

# Instance tags, applied at launch via the launch template (propagate to fleet instances).
tags_json="{\"Key\":\"Name\",\"Value\":\"$name\"},{\"Key\":\"Group\",\"Value\":\"build-instance\"},{\"Key\":\"CI3LaunchId\",\"Value\":\"$launch_id\"}"
[ -n "${GITHUB_ACTOR:-}" ] && tags_json+=",{\"Key\":\"GithubActor\",\"Value\":\"${GITHUB_ACTOR//[\[\]]/}\"}"
[ -n "${CI_MODE:-}" ] && tags_json+=",{\"Key\":\"CICommand\",\"Value\":\"$CI_MODE\"}"
[ -n "${CI_DASHBOARD:-}" ] && tags_json+=",{\"Key\":\"Dashboard\",\"Value\":\"$CI_DASHBOARD\"}"
# Repo is the cost allocation tag that splits the shared account's EC2 and EBS bill by repository.
# Lowercased: CI's GITHUB_REPOSITORY and a local checkout's origin url can differ in case, and a
# cost allocation tag groups by exact value.
repo=$(github_repo)
repo=${repo,,}
[ -n "$repo" ] && tags_json+=",{\"Key\":\"Repo\",\"Value\":\"$repo\"}"
if [ "${UNSAFE_AWS_KEEP_ALIVE:-0}" -eq 1 ]; then
  echo_stderr "You have set UNSAFE_AWS_KEEP_ALIVE=1, so the instance will not be terminated after 1.5 hours by the reaper script. Make sure you shut the machine down when done."
  tags_json+=",{\"Key\":\"Keep-Alive\",\"Value\":\"true\"}"
fi

# Add the boot timer (as user data), and make the instance terminate rather than stop when it shuts
# itself down, so a timed-out instance stops costing anything, its volume included. NO_TERMINATE
# instances are meant to stay up, so they get neither. AWS_SHUTDOWN_TERMINATES=0 keeps the timer but
# leaves shutdown as stop, for callers that power the instance down on purpose (aws/ami_update.sh images it).
lifetime_json=""
if [ "${NO_TERMINATE:-0}" -ne 1 ]; then
  user_data=$(boot_shutdown_script "$AWS_BOOT_SHUTDOWN_TIME" | base64 -w 0)
  lifetime_json="\"UserData\": \"$user_data\","
  if [ "${AWS_SHUTDOWN_TERMINATES:-1}" -eq 1 ]; then
    lifetime_json+=" \"InstanceInitiatedShutdownBehavior\": \"terminate\","
  fi
fi

# Common launch config shared by every pool. Sizes/AZs vary per fleet override.
lt_data=$(cat <<EOF
{
  "ImageId": "$ami",
  $lifetime_json
  "IamInstanceProfile": { "Name": "$CI3_INSTANCE_PROFILE_NAME" },
  "SecurityGroupIds": ["$sg_id"],
  "BlockDeviceMappings": [
    {
      "DeviceName": "/dev/sda1",
      "Ebs": {
        "VolumeSize": 128,
        "VolumeType": "gp3",
        "Throughput": 1000,
        "Iops": 4000
      }
    }
  ],
  "TagSpecifications": [
    { "ResourceType": "instance", "Tags": [ $tags_json ] },
    { "ResourceType": "volume", "Tags": [ $tags_json ] }
  ]
}
EOF
)
echo "$lt_data" > "$spec_path"

lt_name=$launch_id
lt_id=$(aws ec2 create-launch-template \
  --launch-template-name "$lt_name" \
  --launch-template-data "$lt_data" \
  --query 'LaunchTemplate.LaunchTemplateId' --output text)
echo "$lt_id" > "$lt_path"

# Cross every pool with every AZ. Priority biases capacity-optimized toward the
# preferred sizes (see aws_request_instance) while still optimizing for depth.
overrides_json=""
for tok in $overrides_spec; do
  itype=${tok%%:*}
  prio=${tok##*:}
  for sn in "${subnets[@]}"; do
    overrides_json+="{\"InstanceType\":\"$itype\",\"SubnetId\":\"$sn\",\"Priority\":$prio},"
  done
done
ltc="[{\"LaunchTemplateSpecification\":{\"LaunchTemplateId\":\"$lt_id\",\"Version\":\"\$Latest\"},\"Overrides\":[${overrides_json%,}]}]"

info="(name: $name) (pools: ${overrides_spec// /,}) (ami: $ami)"

iid=""
instance_type=""
lifecycle=""

# The fleets' allocation strategies, which a repository may set. Spot: capacity-optimized-prioritized (the default)
# favours the pools with the most spare capacity and treats the pools' priorities as a tiebreak; the others EC2 offers
# (price-capacity-optimized, capacity-optimized, lowest-price, diversified) ignore the priorities. EC2 has no spot
# strategy that honours the priorities strictly. On-demand: lowest-price (the default), or prioritized, which takes
# the highest-priority pool that has capacity.
spot_strategy=${CI_SPOT_ALLOCATION_STRATEGY:-capacity-optimized-prioritized}
ondemand_strategy=${CI_ONDEMAND_ALLOCATION_STRATEGY:-lowest-price}
case "$spot_strategy" in
  capacity-optimized-prioritized | price-capacity-optimized | capacity-optimized | lowest-price | diversified) ;;
  *) echo "CI_SPOT_ALLOCATION_STRATEGY: not a spot allocation strategy: $spot_strategy" >&2; exit 1 ;;
esac
case "$ondemand_strategy" in
  lowest-price | prioritized) ;;
  *) echo "CI_ONDEMAND_ALLOCATION_STRATEGY: not an on-demand allocation strategy: $ondemand_strategy" >&2; exit 1 ;;
esac

# Try spot first, retrying the whole diversified fleet until the time budget
# expires (preserves the historical "give spot ~1 min, then on-demand" pattern).
if [ "${NO_SPOT:-0}" -ne 1 ]; then
  spot_timeout=${CI_SPOT_TIMEOUT:-60}
  spot_poll=${CI_SPOT_POLL:-10}
  SECONDS=0
  while true; do
    echo "Requesting spot fleet $info ($spot_strategy, ${spot_timeout}s budget)..."
    # Record the launch id just before asking for an instance: from this point an instance can exist
    # whose id we do not know yet, and aws_terminate_instance uses this file to look for it.
    echo "$launch_id" > "$launch_id_path"
    resp=$(aws ec2 create-fleet \
      --type instant \
      --target-capacity-specification "TotalTargetCapacity=1,DefaultTargetCapacityType=spot" \
      --spot-options "AllocationStrategy=$spot_strategy" \
      --launch-template-configs "$ltc" \
      --output json 2>"$state_dir/fleet_err") || true
    iid=$(echo "$resp" | jq -r '.Instances[0].InstanceIds[0] // empty' 2>/dev/null || true)
    if [ -n "$iid" ]; then
      instance_type=$(echo "$resp" | jq -r '.Instances[0].InstanceType // empty')
      lifecycle=spot
      break
    fi
    if (( SECONDS + spot_poll >= spot_timeout )); then
      echo "Spot fleet unfulfilled after ${spot_timeout}s; falling back to on-demand."
      break
    fi
    sleep "$spot_poll"
  done
fi

# On-demand fallback (the cheapest pool, or by priority) only if spot couldn't be had. Some pinned pools (e.g.
# m6a.metal for benchmarks) can hit InsufficientInstanceCapacity even on-demand, so retry
# the whole request until a time budget expires rather than giving up on the first miss.
if [ -z "$iid" ]; then
  ondemand_timeout=${CI_ONDEMAND_TIMEOUT:-300}
  ondemand_poll=${CI_ONDEMAND_POLL:-20}
  SECONDS=0
  while true; do
    echo "Requesting on-demand fleet $info ($ondemand_strategy)..."
    # As for spot above.
    echo "$launch_id" > "$launch_id_path"
    resp=$(aws ec2 create-fleet \
      --type instant \
      --target-capacity-specification "TotalTargetCapacity=1,DefaultTargetCapacityType=on-demand" \
      --on-demand-options "AllocationStrategy=$ondemand_strategy" \
      --launch-template-configs "$ltc" \
      --output json 2>"$state_dir/fleet_err") || true
    iid=$(echo "$resp" | jq -r '.Instances[0].InstanceIds[0] // empty' 2>/dev/null || true)
    if [ -n "$iid" ]; then
      instance_type=$(echo "$resp" | jq -r '.Instances[0].InstanceType // empty')
      lifecycle=ondemand
      break
    fi
    if (( SECONDS + ondemand_poll >= ondemand_timeout )); then
      echo "On-demand fleet unfulfilled after ${ondemand_timeout}s; giving up."
      break
    fi
    echo "On-demand capacity unavailable$(echo "$resp" | jq -r '.Errors[0].ErrorCode // "" | if . == "" then "" else " (" + . + ")" end' 2>/dev/null); retrying in ${ondemand_poll}s (elapsed ${SECONDS}s)..."
    sleep "$ondemand_poll"
  done
fi

if [ -z "$iid" ]; then
  echo_stderr "Failed to acquire any instance (spot or on-demand)."
  echo "$resp" | jq -r '.Errors[]? | "  \(.ErrorCode): \(.ErrorMessage)"' >&2 2>/dev/null || true
  cat "$state_dir/fleet_err" >&2 2>/dev/null || true
  exit 1
fi

echo "Instance id: $iid ($instance_type, $lifecycle)"
echo "$iid" > "$iid_path"

# Instances are launched; the launch template is no longer needed.
delete_lt

# Record the instance type so callers can pass it downstream (e.g. into Docker).
echo "$instance_type" > "$state_dir/instance_type"
# Record whether this is spot or on-demand.
echo "$lifecycle" > "$state_dir/spot"

ip=""
while [ -z "${ip:-}" ]; do
  sleep 1
  ip=$(aws ec2 describe-instances \
    --filter "Name=instance-id,Values=$iid" \
    --query "Reservations[*].Instances[*].PublicIpAddress" \
    --output=text)
  echo $ip > $ip_path
done

# Wait for SSM registration and set the shutdown timer.
>&2 echo "Waiting for SSM registration for instance $iid..."
SECONDS=0
while (( SECONDS < 300 )); do
  ssm_status=$(aws ssm describe-instance-information \
    --region us-east-2 \
    --filters "Key=InstanceIds,Values=$iid" \
    --query "InstanceInformationList[0].PingStatus" \
    --output text 2>/dev/null) || true
  >&2 echo "SSM status: ${ssm_status:-Inactive}"
  [ "$ssm_status" = "Online" ] && break
  sleep 5
done

if [ "$ssm_status" != "Online" ]; then
  >&2 echo "Timed out waiting for SSM to see instance $iid"
  exit 1
fi

# Claim the instance: replace the boot timer with the caller's AWS_SHUTDOWN_TIME (see source_shutdown_timer).
# Callers go on to run long jobs, and an unclaimed instance shuts down when the boot timer runs out, so a
# claim that fails is fatal: the instance is terminated and provisioning fails. One failed SSM command
# should not cost a run, so it tries three times first.
if [ "${NO_TERMINATE:-0}" -ne 1 ]; then
  >&2 echo "Setting shutdown timer (+${AWS_SHUTDOWN_TIME:-60} min) via SSM..."
  claimed=0
  for attempt in 1 2 3; do
    if SSM_POLL_TIMEOUT=60 ssm_send_command "$iid" "$(claim_shutdown_cmd "${AWS_SHUTDOWN_TIME:-60}")" >&2; then
      claimed=1
      break
    fi
    [ "$attempt" -lt 3 ] && { >&2 echo "Setting the shutdown timer failed; retrying..."; sleep 5; }
  done
  if [ "$claimed" -ne 1 ]; then
    >&2 echo "Could not set the shutdown timer on $iid; terminating it."
    aws ec2 terminate-instances --instance-ids "$iid" >/dev/null 2>&1 || true
    exit 1
  fi
fi
