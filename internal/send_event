#!/usr/bin/env bash
# Sends one event, given as key=value arguments, as a log record to the OTLP collector. Does nothing
# unless CI_OTEL_TOKEN and CI_OTEL_PROJECT are set. Never fails its caller.
NO_CD=1 source $(dirname "${BASH_SOURCE[0]}")/../source

[ -n "${CI_OTEL_TOKEN:-}" ] && [ -n "${CI_OTEL_PROJECT:-}" ] || exit 0

payload=$(jq -c -n \
  --arg project "$CI_OTEL_PROJECT" \
  --arg repo "$(github_repo)" \
  --arg time "$(date +%s%N)" \
  '{resourceLogs: [{
     resource: {attributes: [
       {key: "project", value: {stringValue: $project}},
       {key: "service.name", value: {stringValue: "ci3"}},
       {key: "deployment.environment.name", value: {stringValue: "ci"}},
       {key: "vcs.repository.name", value: {stringValue: $repo}}]},
     scopeLogs: [{logRecords: [{timeUnixNano: $time, body: {stringValue:
       ($ARGS.positional | map(capture("^(?<key>[^=]+)=(?<value>.*)$"; "s")) | from_entries | tojson)}}]}]}]}' \
  --args "$@") || exit 0

curl -fsS -o /dev/null --max-time 5 \
  -H "Content-Type: application/json" -H "Authorization: Bearer $CI_OTEL_TOKEN" \
  --data "$payload" "${CI_OTEL_ENDPOINT:-https://otel.aztec-labs.com}/v1/logs" ||
  echo_stderr "send_event: not sent."
exit 0
