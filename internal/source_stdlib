# A tiny stdlib of useful functions that don't warrant having their own file.

# TODO: This should be hash_str.
# We need to find places we're using hash_str to generate content hashes, and replace with pure cache_content_hash calls.
function hash_str_orig {
  set -euo pipefail
  echo $1 | git hash-object --stdin | cut -c1-16 | tr -d '\n'
}

function hash_str {
  set -eu
  if [[ "$*" == *"disabled-cache"* ]]; then
    # We want to propagate cache being disabled so that cache_upload and cache_download can catch this
    echo "disabled-cache"
  else
    echo "$*" | git hash-object --stdin | cut -c1-16 | tr -d '\n'
  fi
}

function echo_stderr {
  echo $@ >&2
}

function uuid {
  dd if=/dev/urandom count=8 bs=1 status=none | xxd -p
}

function get_num_cpus {
  if [ -f /sys/fs/cgroup/cpu.max ]; then
    read cpu_quota cpu_period < /sys/fs/cgroup/cpu.max
    if [[ "$cpu_quota" == "max" ]]; then
      nproc
    else
      echo $((cpu_quota / cpu_period))
    fi
  elif [[ "$(uname)" == "Darwin" ]]; then
    sysctl -n hw.ncpu
  else
    nproc
  fi
}

# Hardware threads per physical core: 2 with SMT (most x86 instance families), 1 without (AMD's m7a/r7a/c7a and later,
# Graviton). 2 when it cannot be read, as every caller assumed before.
function get_threads_per_core {
  local tpc
  tpc=$(lscpu 2>/dev/null | awk -F: '/^Thread\(s\) per core/ { gsub(/ /, "", $2); print $2 }')
  [[ "$tpc" =~ ^[1-9][0-9]*$ ]] && echo "$tpc" || echo 2
}

function get_num_cpus_max {
  local jobs=$(get_num_cpus)
  [ -n "${1:-}" ] && [ "$1" -lt $jobs ] && jobs=$1
  echo $jobs
}

function aws_get_meta_data {
  curl -fs -H "X-aws-ec2-metadata-token: $AWS_TOKEN" http://169.254.169.254/latest/meta-data/$1 || true
}

function urlencode {
  printf '%s' "$1" | python3 -c "import urllib.parse, sys; print(urllib.parse.quote(sys.stdin.read(), safe=''))"
}

# True when the given registry URL is npmjs, whatever scheme and trailing slash it is spelled with.
# The public release assertion and the scope routing both key on this, so no spelling can satisfy
# one and not the other: that is how a public release would end up routing its scopes at npmjs
# while switching on the private-registry behaviour that goes with them.
function is_npmjs {
  local host=${1#*://}
  [ "${host%%/*}" = registry.npmjs.org ]
}

function term_link {
  echo -e "${yellow}${link_open}$1${link_close}$2${link_open}${link_close}${reset}"
}

function ci_term_link {
  term_link "$DASHBOARD_URL/$1" "$1"
}

# The repository ci3 is running for, as "<org>/<repo>". GITHUB_REPOSITORY is set by CI;
# outside it, fall back to origin's url so links and names still point at the right repo.
# ci3 is shared by several repositories, so nothing may hardcode one.
function github_repo {
  if [ -z "${GITHUB_REPOSITORY:-}" ]; then
    # -C $root: ci3 is a submodule, so a bare `git` call from inside it would report
    # ci3's own remote rather than the repository being built.
    export GITHUB_REPOSITORY=$(git -C "${root:-.}" remote get-url origin 2>/dev/null \
      | sed -E 's#(\.git)?$##; s#^.*[/:]([^/]+/[^/]+)$#\1#')
  fi
  echo "$GITHUB_REPOSITORY"
}

function github_repo_url {
  echo "https://github.com/$(github_repo)"
}

# Context prefix of a job's per-command commit statuses: ci/<job_id>/, for the given job or this one.
# clear_github_failure_statuses clears the failures under it once the job passes.
function github_status_context_prefix {
  echo "ci/${1:-${JOB_ID:-bootstrap}}/"
}

function pr_link {
  local line=$1
  if [[ $line =~ \(#([0-9]+)\) ]]; then
    pr_number="${BASH_REMATCH[1]}"
    link=$(term_link $(github_repo_url)/pull/$pr_number $pr_number)
    echo -e "${line/\(#${pr_number}\)/(#${link})}"
  else
    echo -e "$line"
  fi
}

export -f hash_str hash_str_orig echo_stderr uuid get_num_cpus get_num_cpus_max get_threads_per_core urlencode term_link ci_term_link pr_link github_status_context_prefix
