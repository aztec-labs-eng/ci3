# Cache system for CI logs.
# Logs are written to Redis (synchronous) and S3 (background).
# Legacy disk transfer functions (SSH to bastion) are kept but no longer used in normal flow.
# NOTE: This file depends on source_redis being sourced first.

# Transfer log to S3 (accepts gzipped data on stdin).
# Usage: cat file.gz | cache_s3_transfer <key>
# S3 path: <CI_LOGS_S3_LOCATION>/logs/<prefix>/<key>.log.gz
function cache_s3_transfer {
  local key="$1"
  local prefix="${key:0:4}"
  local location="${CI_LOGS_S3_LOCATION:-s3://aztec-ci-artifacts/logs}"
  local no_scheme="${location#s3://}"
  local bucket="${no_scheme%%/*}"
  local base_prefix="${no_scheme#*/}"

  aws s3 ${S3_BUILD_CACHE_AWS_PARAMS:-} cp - "s3://${bucket}/${base_prefix}/${prefix}/${key}.log.gz" &>/dev/null
}

# Transfer to S3 with explicit subfolder (accepts gzipped data on stdin).
# Usage: cat file.gz | cache_s3_transfer_to <subfolder> <key>
function cache_s3_transfer_to {
  local subfolder="$1"
  local key="$2"
  local location="${CI_LOGS_S3_LOCATION:-s3://aztec-ci-artifacts/logs}"
  local no_scheme="${location#s3://}"
  local bucket="${no_scheme%%/*}"
  local base_prefix="${no_scheme#*/}"

  aws s3 ${S3_BUILD_CACHE_AWS_PARAMS:-} cp - "s3://${bucket}/${base_prefix}/${subfolder}/${key}.log.gz" &>/dev/null
}

# Transfer log to bastion via SSH (accepts gzipped data on stdin)
# Usage: cat file.gz | cache_disk_transfer <key>
function cache_disk_transfer {
  local key="$1"
  local prefix="${key:0:4}"

  # Transfer via SSH pipe using persistent multiplexed connection
  # Use first 4 chars as subdirectory to avoid too many files in one dir
  ssh -F "${ci3}/aws/build_instance_ssh_config" \
      -o ConnectTimeout=5 \
      ci-bastion.aztecprotocol.com \
      "mkdir -p /logs-disk/${prefix} && cat > /logs-disk/${prefix}/${key}.log.gz" &>/dev/null
}

# Transfer to bastion with explicit subfolder (accepts gzipped data on stdin)
# Usage: cat file.gz | cache_disk_transfer_to <subfolder> <key>
# Legacy: transfer to bastion disk via SSH. Kept for fallback but no longer called in normal flow.
function cache_disk_transfer_to {
  local subfolder="$1"
  local key="$2"

  ssh -F "${ci3}/aws/build_instance_ssh_config" \
      -o ConnectTimeout=5 \
      ci-bastion.aztecprotocol.com \
      "mkdir -p /logs-disk/${subfolder} && cat > /logs-disk/${subfolder}/${key}.log.gz" &>/dev/null
}

# Persistent cache function that writes to both Redis and S3
function cache_persistent {
  local key="$1"
  local expire="$2"
  local tmpfile="/tmp/cache_log_$$_${key}.gz"

  cat | gzip > "$tmpfile"

  # Write to Redis (synchronous). Skipped when redis is unavailable: the noop
  # redis_cli doesn't read stdin, so piping into it would SIGPIPE cat (141
  # under pipefail). The S3 write below still runs, keeping the http log
  # fallback working on keyless runners.
  if [ "$CI_REDIS_AVAILABLE" -eq 1 ]; then
    cat "$tmpfile" | redis_cli -x SETEX "$key" "$expire" &>/dev/null
  fi

  # Write to S3 in background, or in the foreground for a log that must outlive the caller:
  # the build instance's top-level log is persisted as its last act, and a background upload
  # is killed with the container before it lands.
  if [ "${CACHE_PERSIST_SYNC:-0}" -eq 1 ]; then
    log_s3_final "$key" "$tmpfile"
    rm -f "$tmpfile"
  else
    {
      log_s3_final "$key" "$tmpfile"
      rm -f "$tmpfile"
    } >&- 2>&- &
  fi
}

# Without redis, a log's live copies and its final copy are written to the same S3 object, and
# each upload is a snapshot of the log when it started. A per-log lock orders them: a live upload
# skips its turn while another holds the lock, and the final upload waits for it, including one
# whose publishing loop was killed, then leaves a marker that stops any later live upload. So the
# final copy is always the last to land.
function log_s3_lock {
  echo "${TMPDIR:-/tmp}/ci3_log_$1"
}

# Usage: log_s3_final <key> <gzip file>
function log_s3_final {
  if [ "$CI_REDIS_AVAILABLE" -eq 1 ]; then
    cache_s3_transfer "$1" < "$2"
    return
  fi
  local lock=$(log_s3_lock "$1")
  (
    flock -w 150 9
    cache_s3_transfer "$1" < "$2"
    touch "$lock.final"
  ) 9>"$lock.lock"
}

# Whether logs reach the dashboard: through redis, or on a CI host without redis (a GitHub
# runner) straight to S3, which the dashboard reads when redis misses.
function log_store_available {
  [ "$CI_REDIS_AVAILABLE" -eq 1 ] || [ "${CI:-0}" -eq 1 ]
}

# Publish an in-progress log (stdin) where log_store_available found a store.
# Usage: cat log | log_publish <key> <expire>
function log_publish {
  if [ "$CI_REDIS_AVAILABLE" -eq 1 ]; then
    redis_setexz "$1" "$2"
  else
    local lock=$(log_s3_lock "$1") tmp=$(mktemp)
    gzip > "$tmp"
    (
      flock -n 9 || exit 0
      [ -f "$lock.final" ] && exit 0
      # Bounded, so a stuck upload can't hold up the final one waiting on the lock.
      timeout 120 bash -c 'cache_s3_transfer "$0" < "$1"' "$1" "$tmp"
    ) 9>"$lock.lock"
    rm -f "$tmp"
  fi
}

# Export functions
export -f cache_s3_transfer cache_s3_transfer_to cache_disk_transfer cache_disk_transfer_to cache_persistent \
  log_store_available log_publish log_s3_lock log_s3_final
