# Cache system for CI logs.
# Logs are written to Redis (synchronous) and S3 (background).
# NOTE: This file depends on source_redis being sourced first.

# Transfer log to S3 (accepts gzipped data on stdin).
# Usage: cat file.gz | cache_s3_transfer <key>
# S3 path: <CI_LOGS_S3_LOCATION>/logs/<prefix>/<key>.log.gz
function cache_s3_transfer {
  local key="$1"
  local prefix="${key:0:4}"
  local location="${CI_LOGS_S3_LOCATION:-s3://aztec-ci-artifacts/logs}"
  local no_scheme="${location#s3://}"
  local bucket="${no_scheme%%/*}"
  local base_prefix="${no_scheme#*/}"

  aws s3 ${S3_BUILD_CACHE_AWS_PARAMS:-} cp - "s3://${bucket}/${base_prefix}/${prefix}/${key}.log.gz" &>/dev/null
}

# Transfer to S3 with explicit subfolder (accepts gzipped data on stdin).
# Usage: cat file.gz | cache_s3_transfer_to <subfolder> <key>
function cache_s3_transfer_to {
  local subfolder="$1"
  local key="$2"
  local location="${CI_LOGS_S3_LOCATION:-s3://aztec-ci-artifacts/logs}"
  local no_scheme="${location#s3://}"
  local bucket="${no_scheme%%/*}"
  local base_prefix="${no_scheme#*/}"

  aws s3 ${S3_BUILD_CACHE_AWS_PARAMS:-} cp - "s3://${bucket}/${base_prefix}/${subfolder}/${key}.log.gz" &>/dev/null
}

# Whether logs reach the dashboard: through redis, or on a CI host without redis (a GitHub
# runner) straight to S3, which the dashboard reads when redis misses.
function log_store_available {
  [ "$CI_REDIS_AVAILABLE" -eq 1 ] || [ "${CI:-0}" -eq 1 ]
}

# Publish a log (stdin) under <key>, rendered by the dashboard at /<key>.
#   live:  to redis with a ttl of <expire>; on a CI host without redis, to S3.
#   final: also the durable S3 copy the dashboard falls back to once redis expires it. Written in
#          the background, unless LOG_PUBLISH_SYNC=1 (a log that must outlive its caller, such as
#          an instance's top-level log) or redis is unavailable (the S3 copy is the only one).
# With no store at all it just drains stdin.
# Usage: cat log | log_publish <key> <expire> [final]
function log_publish {
  local key=$1 expire=$2 final=${3:-}
  if ! log_store_available; then
    cat >/dev/null
    return 0
  fi
  local tmpfile=$(mktemp)
  gzip > "$tmpfile"
  if [ "$CI_REDIS_AVAILABLE" -eq 1 ]; then
    redis_cli -x SETEX "$key" "$expire" < "$tmpfile" &>/dev/null
    if [ "$final" != final ]; then
      rm -f "$tmpfile"
      return 0
    fi
  fi
  # Bounded, so a stuck upload can't hold up a step that waits for it. A failed upload (say, a
  # runner without AWS credentials) loses the log but never fails the caller.
  if [ "$CI_REDIS_AVAILABLE" -eq 0 ] || [ "${LOG_PUBLISH_SYNC:-0}" -eq 1 ]; then
    timeout 120 bash -c 'cache_s3_transfer "$0" < "$1"' "$key" "$tmpfile" || true
    rm -f "$tmpfile"
  else
    {
      timeout 120 bash -c 'cache_s3_transfer "$0" < "$1"' "$key" "$tmpfile" || true
      rm -f "$tmpfile"
    } >&- 2>&- &
  fi
}

# Runs <publish command> every 5 seconds while <file> exists, whenever the file has changed since the
# last time. A change is a new size or mtime, not a recent mtime: an upload can take longer than the
# interval, and a write made during it must still be published.
#
# Stopped with SIGTERM. bash runs the trap only once the command in progress has finished, so an upload
# in flight completes before the loop exits, and a stopper that waits for the loop knows no older copy
# can land after its own. The sleep is waited on in the background so a signal interrupts it at once.
# Usage: live_publish_file <file> <publish command> &
function live_publish_file {
  local file=$1 publish=$2 sleep_pid= published= current
  trap 'kill $sleep_pid &>/dev/null; exit 0' TERM
  while [ -f "$file" ]; do
    current=$(stat -c '%s %Y' "$file" 2>/dev/null)
    if [ -n "$current" ] && [ "$current" != "$published" ]; then
      published=$current
      $publish
    fi
    sleep 5 &
    sleep_pid=$!
    wait $sleep_pid
  done
}

# Export functions
export -f cache_s3_transfer cache_s3_transfer_to log_store_available log_publish live_publish_file
