#!/usr/bin/env bash
# Launches a CI build on an EC2 instance. The instance has no SSH key pair and accepts no inbound
# connections: the build is sent to it with SSM RunShellScript, and it gets its AWS credentials from
# its instance profile.

NO_CD=1 source $(dirname "${BASH_SOURCE[0]}")/source
source $ci3/internal/source_refname

cmd=${1:?usage: $(basename "$0") '<command-to-run-inside-devbox>'}
# The repository being built, and the checkout directory named after it. ci3 is shared by
# several repos, so nothing here may assume a particular one.
github_repository=$(github_repo)
[ -n "$github_repository" ] || { echo_stderr "Cannot determine GITHUB_REPOSITORY (<org>/<repo>)."; exit 1; }
repo_dir=${github_repository##*/}
arch=${ARCH:-amd64}
NO_TERMINATE=${NO_TERMINATE:-0}
status_job_id=${JOB_ID:-bootstrap}

# We're always "in CI" if we're running on a remote instance.
export CI=1

# Pre-generate a log ID and print the dashboard link.
export CI_LOG_ID=$(date +%s%3N)$((100 + RANDOM % 900))
echo "CI booting..." | log_publish "$CI_LOG_ID" 300
log_url="http://ci.aztec-labs.com/$CI_LOG_ID"
echo -e "CI Log: ${yellow}$log_url${reset}"
# Publish the id to later workflow steps so a failure notification can link the build
# log itself, not just the GitHub run (the real error is in the former).
if [ -n "${GITHUB_ENV:-}" ]; then
  echo "CI_LOG_ID=$CI_LOG_ID" >>"$GITHUB_ENV"
fi
if [ -n "${CI_DASHBOARD:-}" ]; then
  echo "CI dashboard: http://ci.aztec-labs.com/section/$CI_DASHBOARD"
fi

# Post pending GitHub commit status so the CI log link is visible on the PR.
post_github_status pending "ci/${status_job_id}" "$log_url" "${cmd:0:140}" 2>/dev/null || true

if [ "$arch" == "arm64" ]; then
  cores=64
  export AWS_SHUTDOWN_TIME=${AWS_SHUTDOWN_TIME_ARM:-${AWS_SHUTDOWN_TIME:-60}}
else
  cores=192,128,64
  if [ "${CI_FULL:-0}" -eq 1 ]; then
    export AWS_SHUTDOWN_TIME=${AWS_SHUTDOWN_TIME:-75}
  else
    export AWS_SHUTDOWN_TIME=${AWS_SHUTDOWN_TIME:-60}
  fi
fi

# Allow override.
cores=${CPUS:-$cores}

# In the background and detached from the output pipes: a slow collector must not delay anything.
function report_instance {
  [ -n "${CI3_EVENT_ENDPOINT:-}" ] && [ -n "${CI3_EVENT_TOKEN:-}" ] && [ -n "${CI3_EVENT_PROJECT:-}" ] || return 0
  # From state_dir: provisioning can fail after the launch, before bootstrap_ec2 reads these.
  [ -s "${state_dir:-}/iid" ] && [ -z "${instance_reported:-}" ] || return 0
  instance_reported=1
  send_event \
    event=ci.instance \
    ci_log_id="${CI_LOG_ID:-}" \
    run_id="${GITHUB_RUN_ID:-}" \
    run_attempt="${GITHUB_RUN_ATTEMPT:-}" \
    pr_number="${PR_NUMBER:-}" \
    instance_id="$(tr -d '[:space:]' <"$state_dir/iid")" \
    instance_type="$(cat "$state_dir/instance_type" 2>/dev/null || echo unknown)" \
    lifecycle="$(cat "$state_dir/spot" 2>/dev/null || echo unknown)" \
    instance_s=$(($(date +%s) - requested_at)) \
    ready_s="${ready_at:+$((ready_at - requested_at))}" \
    evicted="$1" >/dev/null 2>&1 &
}

# Terminates our instance when the script exits.
function cleanup {
  # First: a cancelled job may not live through the termination.
  report_instance false
  stop_lease
  if [ -d "${state_dir:-}" ]; then
    aws_terminate_instance "$state_dir" >/dev/null 2>&1
  fi
}

# The instance shuts itself down unless its lease keeps being renewed (see
# internal/source_instance_lease). This renews it until the run's deadline, AWS_SHUTDOWN_TIME from now,
# for as long as this script is alive, whatever ends it.
lease_pid=
function start_lease {
  [ "$NO_TERMINATE" -eq 1 ] && return
  aws_instance_lease "$state_dir" $(($(date +%s) + AWS_SHUTDOWN_TIME * 60)) $$ &
  lease_pid=$!
}
function stop_lease {
  [ -n "$lease_pid" ] && kill "$lease_pid" 2>/dev/null
  lease_pid=
}

# Cancellation. CI cancels by signalling only the process it started, so a caller must exec into this
# script, and everything slow here runs in the background under `wait`, which a signal interrupts at
# once (bash runs a trap only after a foreground command finishes). The child is stopped first, so
# an instance request in flight records its instance before cleanup reads it. Repeated signals, such
# as a second Ctrl-C or CI's SIGTERM after its SIGINT, are ignored until cleanup is done, and so is
# SIGPIPE: the log readers on our stdout may already be gone, and cleanup must not die writing to them.
interruptible_pid=
function on_signal {
  trap '' SIGINT SIGTERM SIGPIPE
  # Every step is best effort. Under errexit, the child's nonzero exit would end the handler here.
  set +e
  if [ -n "$interruptible_pid" ]; then
    kill -TERM "$interruptible_pid" 2>/dev/null
    wait "$interruptible_pid" 2>/dev/null
  fi
  cleanup >/dev/null 2>&1
  # Without it, the commit's status stays pending, shown as still running, once the run is gone.
  post_github_status --wait error "ci/${status_job_id}" "$log_url" "Cancelled" >/dev/null 2>&1
  trap - EXIT
  exit 143
}
trap on_signal SIGINT SIGTERM
trap 'cleanup >/dev/null 2>&1' EXIT

# Verify that the commit exists on the remote. --negotiate-only asks origin which commits it has in
# common with this tip and transfers no objects, so the commit itself appears in the output only
# when origin already has it. The exit status is checked separately from the output, so a failure
# to reach origin — unreachable, rate-limited, or killed alongside a failing sibling job — is not
# reported as an unpushed commit.
current_commit=$(git rev-parse HEAD)
if ! common=$(git fetch origin --negotiate-only --negotiation-tip="$current_commit"); then
  >&2 echo "Could not reach origin to check whether $current_commit is pushed."
  exit 1
fi
if [[ "$common" != *"$current_commit"* ]]; then
  >&2 echo "Commit $current_commit is not pushed, exiting."
  exit 1
fi

# Our instance_name acts as a uniqueness key for the instance: an existing instance
# with the same name is terminated first, reaping orphans left when a GA run is
# cancelled (e.g. by a new push) on the same ref. It's repo-scoped so
# aztec-packages{,-private} don't reap each other, and stable across re-runs within a
# repo so cleanup still works. Derived by aws_instance_name, shared with ci.sh's
# connect/kill helpers so the launch and connect names never drift.
instance_name=$(aws_instance_name "$REF_NAME" "$arch" "${INSTANCE_POSTFIX:-}")

state_dir=$(mktemp -d /tmp/aws_request_instance.XXXXXX)

docker_hostname=$(echo -n "$instance_name" | tr '_' '-' | cut -c 1-63)

echo_header "request build instance"

# Terminate any existing instances with the same name.
existing_instance=$(aws ec2 describe-instances \
  --region us-east-2 \
  --filters "Name=tag:Name,Values=$instance_name" "Name=instance-state-name,Values=running" \
  --query "Reservations[].Instances[?State.Name!='terminated'].InstanceId[]" \
  --output text)
if [ -n "$existing_instance" ]; then
  for i in $existing_instance; do
    echo "Terminating existing instance: $i"
    aws ec2 --region us-east-2 terminate-instances --instance-ids "$i" >/dev/null 2>&1
  done
fi

# Request new instance.
requested_at=$(date +%s)
start_lease
interruptible aws_request_instance "$instance_name" "$cores" "$arch" "$state_dir"
ready_at=$(date +%s)
sir=""
if [[ -f "$state_dir/sir" ]]; then
  sir=$(cat "$state_dir/sir")
fi
iid=$(cat "$state_dir/iid" | tr -d '\n\r' | xargs)
export EC2_INSTANCE_TYPE=$(cat "$state_dir/instance_type" 2>/dev/null || echo "unknown")
export EC2_SPOT=$(cat "$state_dir/spot" 2>/dev/null || echo "unknown")

run_cmd="PARENT_LOG_ID=\$ci_log_id run 2>&1 | ci3/add_timestamps | DUP=1 ci3/cache_log 'CI run' \$ci_log_id"

# --- Container script ---
# This runs inside the devbox Docker container.
container_script=$(
  cat <<EOF
  set -euo pipefail
  # When restarting the container, just hang around.
  # Note we use the "ci-started" file to determine if we're running on a CI machine in some cases (e.g. npm cache).
  while [ -f ci-started ]; do sleep 999; done
  touch ci-started
  sudo chown aztec-dev:aztec-dev $repo_dir
  cd $repo_dir
  git config --global advice.detachedHead false
  git init .
  if [ -n "\${GITHUB_TOKEN:-}" ]; then
    git remote add origin "https://x-access-token:\$GITHUB_TOKEN@github.com/\$GITHUB_REPOSITORY.git"
  else
    git remote add origin "https://github.com/\$GITHUB_REPOSITORY.git"
  fi
  git fetch --depth 1 origin $current_commit
  git checkout FETCH_HEAD
  git checkout -b \$REF_NAME
  # ci3 is a submodule and the shallow fetch above does not bring it: init it before
  # anything sources it.
  git submodule update --init --depth 1 ci3
  # The repository's own post-checkout step, such as applying a patch to the tree, runs before
  # ci3/source derives COMMIT_HASH from HEAD. Its output is replayed in run:
  # ci3/internal/ssm_send_command shows only stderr, and only on failure.
  post_checkout_log=
  if [ -x .github/ci3_post_checkout.sh ]; then
    post_checkout_log=\$(.github/ci3_post_checkout.sh)
  fi
  source ci3/source
  # A private cache this instance cannot reach means the wrong instance profile: fail now, not after a
  # build that cached nothing.
  cache_is_public || source ci3/source_cache_bucket "\$(cache_bucket)"
  ci_log_id=\$CI_LOG_ID
  log_ci_run \$ci_log_id

  if [ -n "\${DOCKER_PASSWORD:-}" ]; then
    docker_login
  fi

  # Heartbeat.
  while true; do redis_cli SETEX hb-\$ci_log_id 60 1 &>/dev/null || true; sleep 30; done &

  function run {
    echo "env: REF_NAME=\$REF_NAME COMMIT_HASH=\$COMMIT_HASH TARGET_BRANCH=\$TARGET_BRANCH"
    if semver check "\$REF_NAME"; then
      echo "Performing a release because \$REF_NAME is a semver."
    fi
    [ -z "\$post_checkout_log" ] || echo "\$post_checkout_log"

    # Background monitors. cache_log and add_timestamps both close inherited pipeline
    # fds internally, so these long-running processes won't block the outer pipeline.
    mpstat 2 2>&1 | cache_log cpufile &
    vmstat -w -S M 2 2>&1 | add_timestamps | cache_log memfile &
    bash -c "while true; do pstree -agl; echo; echo; sleep 10; done" 2>&1 | add_timestamps | cache_log processes &

    set +e
    set -x
    $cmd
    local code=\${PIPESTATUS[0]}
    set +x

    sudo dmesg 2>&1 | cache_log 'dmesg'

    return \$code
  }
  export -f run

  set +e
  $run_cmd
  code=\${PIPESTATUS[0]}

  case \$code in
    155) ;;
    0) log_ci_run \$ci_log_id PASSED ;;
    *)
      log_ci_run \$ci_log_id FAILED
      ;;
  esac
  exit \$code
EOF
)

# --- Host script ---
# This runs on the EC2 host, via SSM.
# The consuming repository says what else reaches the build container, both space-separated lists of
# variable names, usually set in its CI entry point:
#   CI3_PASS_ENV    variables passed as they are (the repository's own tokens and settings). Each is
#                   quoted for the host's shell.
#   CI3_PASS_FILES  variables holding the path of a file on this machine (a service account key, an
#                   env file). The file is copied to the instance under /tmp/ci3-files, which the
#                   container shares, and the variable is passed pointing at the copy. One that is
#                   unset or empty is skipped, as is one naming no file.
function check_pass_name {
  if [[ ! "$2" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
    echo_stderr "$1: not a variable name: $2"
    exit 1
  fi
}
pass_env_args=""
for pass_env_name in ${CI3_PASS_ENV:-}; do
  check_pass_name CI3_PASS_ENV "$pass_env_name"
  pass_env_args+=" -e $pass_env_name=$(printf %q "${!pass_env_name:-}")"
done
pass_files_script=""
for pass_file_name in ${CI3_PASS_FILES:-}; do
  check_pass_name CI3_PASS_FILES "$pass_file_name"
  pass_file=${!pass_file_name:-}
  [ -n "$pass_file" ] || continue
  if [ ! -f "$pass_file" ]; then
    echo_stderr "CI3_PASS_FILES: $pass_file_name=$pass_file is not a file; not passing it."
    continue
  fi
  pass_files_script+="base64 -d > /tmp/ci3-files/$pass_file_name <<<'$(base64 -w 0 "$pass_file")'"$'\n'
  pass_env_args+=" -e $pass_file_name=/tmp/ci3-files/$pass_file_name"
done

host_script=$(
  cat <<EOF
set -euo pipefail

# This runtime guard should be baked into the build image. Unattended upgrades
# can restart SSM while CI is running, leaving SSM commands stuck InProgress.
echo "HOST: disabling apt periodic upgrades..."
sudo systemctl mask --now apt-daily.timer apt-daily-upgrade.timer apt-daily.service apt-daily-upgrade.service unattended-upgrades.service &>/dev/null || true

sudo sysctl fs.inotify.max_user_watches=1048576 &>/dev/null
sudo sysctl fs.inotify.max_user_instances=1048576 &>/dev/null

# DNS caching. CI's massively parallel jobs resolve the same handful of hosts (S3,
# Docker Hub, npm, cargo, github) thousands of times. By default every lookup — from
# the devbox container and nested docker-in-docker alike — goes straight to the VPC
# resolver, which AWS caps at ~1024 pps per ENI for link-local services; over that,
# packets are silently dropped and surface as "could not resolve host".
# Route container lookups through the host's (caching) systemd-resolved instead, by
# exposing its stub on the instance's primary private IP — the one address reachable
# from both the devbox container and nested dind — and pointing containers at it via
# --dns on docker run below. priv_ip is cleared (and --dns omitted, leaving DNS
# unchanged) if any step fails, so this can only help, never break resolution.
priv_ip=\$(ip -4 route get 169.254.169.253 2>/dev/null | awk '{for(i=1;i<=NF;i++) if(\$i=="src"){print \$(i+1); exit}}' || true)
if [ -n "\$priv_ip" ] && systemctl is-active --quiet systemd-resolved \
   && echo "DNSStubListenerExtra=\$priv_ip" | sudo tee -a /etc/systemd/resolved.conf >/dev/null \
   && sudo systemctl restart systemd-resolved; then
  # Only route containers to the cache once it's actually listening on priv_ip.
  for _ in 1 2 3 4 5; do
    sudo ss -lnu "sport = :53" 2>/dev/null | grep -qF "\$priv_ip:53" && { dns_ready=1; break; }
    sleep 0.5
  done
  if [ "\${dns_ready:-0}" = 1 ]; then
    echo "HOST: DNS cache active on \$priv_ip (systemd-resolved)."
  else
    echo "HOST: DNS cache failed to bind \$priv_ip; using default resolver."
    priv_ip=
  fi
else
  echo "HOST: DNS cache not configured; using default resolver."
  priv_ip=
fi

# Pin host processes to top CPU cores to keep benchmark cores clean.
# CPU layout: physical cores 0..N/2-1, hyperthreads N/2..N-1.
# OS gets top 8 physical cores + their hyperthread siblings.
# Skip dockerd so containers it spawns can use all CPUs for build/test.
total_cpus=\$(nproc)
total_physical=\$((total_cpus / 2))
os_start=\$((total_physical - 8))
os_ht_start=\$((total_cpus - 8))
os_cpu_list="\$os_start-\$((total_physical - 1)),\$os_ht_start-\$((total_cpus - 1))"
for pid in \$(ps -eo pid= 2>/dev/null); do
  comm=\$(cat /proc/\$pid/comm 2>/dev/null) || continue
  [ "\$comm" = "dockerd" ] && continue
  sudo taskset -apc "\$os_cpu_list" \$pid &>/dev/null || true
done
echo "Host processes pinned to OS CPUs: \$os_cpu_list"

echo "HOST: fetching EC2 metadata token..."
aws_token=\$(curl -sX PUT http://169.254.169.254/latest/api/token -H 'X-aws-ec2-metadata-token-ttl-seconds: 21600')
echo "HOST: metadata token acquired."

echo "HOST: writing passed files..."
(umask 077 && mkdir -p /tmp/ci3-files
$pass_files_script)

start_build() {
  echo "HOST: preparing devbox (uid/gid, docker run)..."
  local_uid=\$(id -u)
  local_gid=\$(id -g)

  docker run --privileged --rm \${docker_args:-} \${priv_ip:+--dns \$priv_ip} \
    --name aztec_build \
    --hostname $docker_hostname \
    -v bootstrap_ci_local_docker:/var/lib/docker \
    -v bootstrap_ci_repo:/home/aztec-dev/$repo_dir \
    -v \$HOME/.ssh:/home/aztec-dev/.ssh:ro \
    -v \$HOME/.bb-crs:/home/aztec-dev/.bb-crs \
    -v /dev/kmsg:/dev/kmsg \
    -v /tmp:/tmp \
    -e CI=1 \
    -e CI_LOG_ID=${CI_LOG_ID:-} \
    -e CI_LOGS_S3_LOCATION=${CI_LOGS_S3_LOCATION:-s3://aztec-ci-artifacts/logs} \
    -e RUN_ID=${RUN_ID:-} \
    -e JOB_ID=${JOB_ID:-} \
    -e REF_NAME=${REF_NAME:-} \
    -e TARGET_BRANCH=${TARGET_BRANCH:-} \
    -e DEFAULT_BRANCH=$(ci_default_branch) \
    -e CI_MAINLINE_BRANCHES=$(printf %q "${CI_MAINLINE_BRANCHES:-}") \
    -e CI_DASHBOARD=${CI_DASHBOARD:-} \
    -e PARENT_LOG_ID=${PARENT_LOG_ID:-} \
    -e NO_CACHE=${NO_CACHE:-} \
    -e NO_CACHE_UPLOAD=${NO_CACHE_UPLOAD:-} \
    -e CI3_CACHE_BUCKET=$(cache_bucket) \
    -e CI3_INSTANCE_PROFILE_NAME=${CI3_INSTANCE_PROFILE_NAME:-} \
    -e NO_FAIL_FAST=${NO_FAIL_FAST:-} \
    -e CI_REDIS='ci-redis-tiered.lzka0i.ng.0001.use2.cache.amazonaws.com' \
    -e SSH_CONNECTION=' ' \
    -e LOCAL_USER_ID=\$local_uid \
    -e LOCAL_GROUP_ID=\$local_gid \
    -e DOCKER_REGISTRY=${DOCKER_REGISTRY:-} \
    -e DOCKER_PASSWORD=${DOCKER_PASSWORD:-} \
    -e DOCKER_USERNAME=${DOCKER_USERNAME:-} \
    -e BUILD_SYSTEM_DEBUG=${BUILD_SYSTEM_DEBUG:-} \
    -e GITHUB_TOKEN=${GITHUB_TOKEN:-} \
    -e GITHUB_REPOSITORY=$github_repository \
    -e PR_NUMBER=${PR_NUMBER:-} \
    -e PR_HEAD_REF=${PR_HEAD_REF:-} \
    -e PR_BASE_REF=${PR_BASE_REF:-} \
    -e NPM_REGISTRY=${NPM_REGISTRY:-} \
    -e NPM_TOKEN=${NPM_TOKEN:-} \
    -e NPM_USERNAME=${NPM_USERNAME:-} \
    -e NPM_PASSWORD=${NPM_PASSWORD:-} \
    -e SLACK_BOT_TOKEN=${SLACK_BOT_TOKEN:-} \
    -e AWS_TOKEN=\$aws_token \
    -e GITHUB_ACTOR=${GITHUB_ACTOR:-} \
    -e EC2_INSTANCE_TYPE=${EC2_INSTANCE_TYPE:-unknown} \
    -e EC2_SPOT=${EC2_SPOT:-unknown} \
    -e BENCH_UPLOAD=${BENCH_UPLOAD:-} \
    -e DRY_RUN=${DRY_RUN:-} \
    --pids-limit=65536 \
    --shm-size=2g \
    --ulimit nofile=1048576:1048576 \
    $pass_env_args \
    aztecprotocol/devbox:3.2 bash -c $(printf '%q' "$container_script")
}

# Run the build in the background, and handle spot termination notices.
echo "HOST: starting devbox container..."
start_build &
build_pid=\$!
echo "HOST: devbox container launched (pid=\$build_pid). Monitoring for spot termination..."

# While the docker container is running, check for spot termination notices.
while kill -0 \$build_pid &>/dev/null; do
  # The check for the file allows for testing spot termination logic.
  if [ -f /tmp/spot_term ] || curl -fs -H 'X-aws-ec2-metadata-token: '\$aws_token http://169.254.169.254/latest/meta-data/spot/termination-time &>/dev/null; then
    echo 'Spot will be terminated! Exiting early.'
    docker kill aztec_build &>/dev/null || true
    exit 155
  fi
  sleep 5
done

# Returns exit code from docker run.
wait \$build_pid
EOF
)

# --- Send host_script to the instance ---
echo_header "invoke SSM command"
# Send host script via SSM and poll until completion. As ubuntu, not SSM's default of root.
set +e
SSM_RUN_AS=ubuntu SSM_POLL_TIMEOUT=${SSM_POLL_TIMEOUT:-$((AWS_SHUTDOWN_TIME * 60 + 600))} \
  interruptible ssm_send_command "$iid" "$host_script"
exit_code=$?
set -e

# If we were spot evicted, try again using on-demand.
if [ "$exit_code" -eq 155 ]; then
  echo "Spot was evicted. Retrying with on-demand instance."
  # exec skips the EXIT trap, and the evicted instance needs no termination.
  report_instance true
  stop_lease
  NO_SPOT=1 exec "$0" "$@"
else
  # Print CI log URL at the end for easy access (avoid scrolling up).
  echo -e "CI Log: ${yellow}$log_url${reset}"
  # Post final GitHub commit status.
  if [ "$exit_code" -eq 0 ]; then
    post_github_status success "ci/${status_job_id}" "$log_url" "${cmd:0:140}" 2>/dev/null || true
    clear_github_failure_statuses "$status_job_id" "$log_url" 2>/dev/null || true
  else
    post_github_status failure "ci/${status_job_id}" "$log_url" "${cmd:0:140}" 2>/dev/null || true
  fi
  exit "$exit_code"
fi
