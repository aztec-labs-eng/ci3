#!/usr/bin/env bash
# Tests the Slack post internal/run_test_cmd sends for a flake, against a curl stub on PATH:
# - an entry with owners gets a post that mentions them and asks them, as owner, to remove the entry
# - an entry without owners gets the same post without the mention and without "As owner"
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SCRIPT="$SCRIPT_DIR/../internal/run_test_cmd"

RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
NC=$'\033[0m'

TESTS_PASSED=0
TESTS_FAILED=0

pass() { echo "${GREEN}✓${NC} $1"; ((TESTS_PASSED++)) || true; }
fail() {
  echo "${RED}✗${NC} $1: $2"
  ((TESTS_FAILED++)) || true
}

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

# The stub appends each posted Slack text to $tmp/posted.
mkdir "$tmp/bin"
cat >"$tmp/bin/curl" <<'EOF'
#!/usr/bin/env bash
while [ $# -gt 0 ]; do
  [ "$1" == "--data" ] && jq -r .text <<<"$2" >>"$STUB_DIR/posted"
  shift
done
echo '{"ok": true}'
EOF
chmod +x "$tmp/bin/curl"

# Fails on its first run and passes on the next.
cat >"$tmp/flaky" <<'EOF'
#!/usr/bin/env bash
[ -f "$STUB_DIR/ran" ] && exit 0
touch "$STUB_DIR/ran"
echo "the monitored command dumped core"
exit 1
EOF
chmod +x "$tmp/flaky"

cat >"$tmp/.test_patterns.yml" <<'EOF'
tests:
  - regex: 'flaky one'
    retry: true
    owners: ["U1"]
  - regex: 'flaky two'
    retry: true
EOF

# Runs the given test command to a flake and prints the Slack text it posted.
function run_flake {
  rm -f "$tmp/posted" "$tmp/ran"
  # The stub goes after ci3's own directories, which source puts first unless PATH starts with them.
  (cd "$tmp" && env STUB_DIR="$tmp" PATH="$SCRIPT_DIR/..:$SCRIPT_DIR/../internal:$tmp/bin:$PATH" \
    CI=0 CI_REDIS_AVAILABLE=0 REF_NAME=main COMMIT_HASH=abc GITHUB_REPOSITORY=org/repo SLACK_NOTIFY_FLAKE=1 \
    ALLOW_FLAKES=1 SLACK_BOT_TOKEN=t DASHBOARD_URL=http://ci.example \
    "$SCRIPT" "hash $tmp/flaky $1" &>/dev/null)
  sed "s|http://ci.example/[^|]*|LOG|" "$tmp/posted"
}

patterns="<https://github.com/org/repo/blob/abc/.test_patterns.yml|flaky test patterns>"

got=$(run_flake "flaky one")
want="<@U1>: Test <LOG|flaked> on *main*: \`$tmp/flaky flaky one\`. This is a known flake and it was retried. As owner, please address this flake and then remove it from $patterns."
[ "$got" == "$want" ] && pass "asks the owners to remove the entry" || fail "asks the owners to remove the entry" "$got"

got=$(run_flake "flaky two")
want="Test <LOG|flaked> on *main*: \`$tmp/flaky flaky two\`. This is a known flake and it was retried. Please address this flake and then remove it from $patterns."
[ "$got" == "$want" ] && pass "leaves out \"As owner\" when the entry has no owners" || fail "leaves out \"As owner\" when the entry has no owners" "$got"

echo "$TESTS_PASSED passed, $TESTS_FAILED failed"
[ "$TESTS_FAILED" -eq 0 ]
