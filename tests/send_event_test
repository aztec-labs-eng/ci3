#!/usr/bin/env bash
# internal/send_event with curl stubbed out.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/../source"

dir=$(mktemp -d)
trap 'rm -rf "$dir"' EXIT
printf '#!/usr/bin/env bash\nprintf "%%s\\n" "$@" >>"%s/calls"\nexit ${CURL_EXIT:-0}\n' "$dir" >"$dir/curl"
chmod +x "$dir/curl"
export PATH="$dir:$PATH" GITHUB_REPOSITORY=org/repo
fail() { echo "FAIL: $1"; exit 1; }

CI_OTEL_TOKEN= CI_OTEL_PROJECT=p send_event a=b
CI_OTEL_TOKEN=t CI_OTEL_PROJECT= send_event a=b
[ ! -e "$dir/calls" ] || fail "sent without a token and a project"

CI_OTEL_TOKEN=t0ken CI_OTEL_PROJECT=proj send_event event=x eq=a=b
grep -qx "https://otel.aztec-labs.com/v1/logs" "$dir/calls" || fail "endpoint"
grep -qx "Authorization: Bearer t0ken" "$dir/calls" || fail "token"
payload=$(grep resourceLogs "$dir/calls")
[ "$(jq -r '.resourceLogs[0].scopeLogs[0].logRecords[0].body.stringValue' <<<"$payload")" == '{"event":"x","eq":"a=b"}' ] || fail "body"
[ "$(jq -r '.resourceLogs[0].resource.attributes[0].value.stringValue' <<<"$payload")" == proj ] || fail "project"

CURL_EXIT=22 CI_OTEL_TOKEN=t CI_OTEL_PROJECT=p send_event a=b 2>/dev/null || fail "failed its caller"

echo "send_event: passed"
