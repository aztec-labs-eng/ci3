#!/usr/bin/env bash
# Whether cache_upload and cache_upload_stream find AWS credentials from any source, not just static keys.
# A build instance has only its instance profile, so no key in the environment or the config file. Here a
# profile's credential_process stands in for it: the same provider chain resolves both.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
passed=0
failed=0
pass() { echo -e "  \033[32m✓ $1\033[0m"; ((++passed)); }
fail() { echo -e "  \033[31m✗ $1\033[0m"; ((++failed)); }

cat >"$tmp/config" <<EOF
[default]
region = us-east-2
credential_process = printf '{"Version":1,"AccessKeyId":"AKIATESTTESTTESTTEST","SecretAccessKey":"test","SessionToken":"test"}'
EOF
echo data >"$tmp/file"

# Run an upload script in a clean environment. Port 9 refuses connections, so nothing is uploaded.
function upload {
  local config=$1 script=$2
  shift 2
  env -i PATH="$PATH" HOME="$tmp" CI=1 AWS_CONFIG_FILE="$config" AWS_SHARED_CREDENTIALS_FILE=/dev/null \
    AWS_EC2_METADATA_DISABLED=true AWS_MAX_ATTEMPTS=1 S3_BUILD_CACHE_AWS_PARAMS="--endpoint-url http://127.0.0.1:9" \
    "$script_dir/$script" "$@" 2>&1 </dev/null || true
}

for script in cache_upload cache_upload_stream; do
  [ "$script" = cache_upload ] && args=(test.tar.gz "$tmp/file") || args=(test.zst)

  out=$(upload "$tmp/config" $script "${args[@]}")
  if [[ "$out" != *"no AWS credentials"* ]]; then
    pass "$script: credentials from a provider are used"
  else
    fail "$script: credentials from a provider were not found: $out"
  fi

  out=$(upload /dev/null $script "${args[@]}")
  if [[ "$out" == *"no AWS credentials"* ]]; then
    pass "$script: skips when there are no credentials"
  else
    fail "$script: did not skip without credentials: $out"
  fi
done

echo
echo "$passed passed, $failed failed."
[ "$failed" -eq 0 ]
