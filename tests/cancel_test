#!/usr/bin/env bash
# Cancelling a CI run terminates its instances. Runs bootstrap_ec2 and bootstrap_ec2_multi against a stub
# aws, and cancels them the ways they are cancelled for real:
#   - as GitHub Actions does: SIGINT to the one process it started, SIGTERM 7.5s later, SIGKILL 2.5s
#     after that. The entry point is that process, as a workflow step that execs into it makes it.
#   - as a terminal does on Ctrl-C: SIGINT to the whole foreground process group, here twice, the second
#     during cleanup.
# Each case passes when every instance launched has been terminated and its SSM command cancelled
# before the SIGKILL would land, every commit status it posted has been finished as an error, and no
# process of the run is left.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
tmp=$(mktemp -d)
trap 'pkill -KILL -f "$tmp/" 2>/dev/null || true; rm -rf "$tmp"' EXIT
passed=0
failed=0
pass() { echo -e "  \033[32m✓ $1\033[0m"; ((++passed)); }
fail() { echo -e "  \033[31m✗ $1\033[0m"; ((++failed)); }

# A repository whose commit is on its origin, as bootstrap_ec2 requires.
git init -q --bare "$tmp/origin.git"
git init -q "$tmp/repo"
git -C "$tmp/repo" -c user.name=t -c user.email=t@t commit -q --allow-empty -m init
git -C "$tmp/repo" remote add origin "$tmp/origin.git"
git -C "$tmp/repo" push -q origin HEAD:refs/heads/main

# The stub aws: launches numbered instances, keeps SSM commands InProgress unless told otherwise, and
# logs what it was asked to do. STUB_FLEET_DELAY and STUB_TERMINATE_DELAY slow those calls down. A
# case cancels once each command is being polled: by then its caller holds the command id, which a
# cancel during send-command would lose.
mkdir -p "$tmp/bin"
cat >"$tmp/bin/aws" <<'EOF'
#!/usr/bin/env bash
state=${STUB_STATE:?}
log() { flock "$state/lock" bash -c 'echo "$1" >>"$2"' _ "$1" "$state/calls"; }
args="$*"
case "$1 $2" in
  "ec2 describe-security-groups") echo vpc-1 ;;
  "ec2 describe-subnets") printf 'us-east-2a\tsubnet-1\n' ;;
  "ec2 create-launch-template") echo lt-1 ;;
  "ec2 delete-launch-template") ;;
  "ec2 create-fleet")
    log "requesting fleet"
    sleep "${STUB_FLEET_DELAY:-0}"
    n=$(flock "$state/lock" bash -c 'n=$(($(cat "$1" 2>/dev/null || echo 0) + 1)); echo $n >"$1"; echo $n' _ "$state/count")
    log "launched i-$n"
    echo "{\"Instances\":[{\"InstanceIds\":[\"i-$n\"],\"InstanceType\":\"m6a.32xlarge\"}]}" ;;
  "ec2 describe-instances")
    if [[ "$args" == *instance-id* ]]; then echo 10.0.0.1; fi ;;
  "ec2 terminate-instances")
    sleep "${STUB_TERMINATE_DELAY:-0}"
    for id in ${args#*--instance-ids }; do [[ "$id" == i-* ]] && log "terminated $id"; done ;;
  "ec2 describe-instance-status") echo running ;;
  "ssm describe-instance-information") echo Online ;;
  "ssm send-command")
    iid=$(grep -o -- '--instance-ids [^ ]*' <<<"$args" | cut -d' ' -f2)
    log "command on $iid"
    echo cmd-$iid ;;
  "ssm get-command-invocation")
    log "polling $(grep -o -- '--command-id [^ ]*' <<<"$args" | cut -d' ' -f2)"
    echo "{\"Status\":\"$(cat "$state/ssm_status" 2>/dev/null || echo InProgress)\",\"ResponseCode\":0}" ;;
  "ssm cancel-command")
    log "cancelled $(grep -o -- '--command-id [^ ]*' <<<"$args" | cut -d' ' -f2)" ;;
esac
EOF
chmod +x "$tmp/bin/aws"

# The stub curl logs each commit status posted, as "status <context> <state>", and does nothing else.
cat >"$tmp/bin/curl" <<'EOF'
#!/usr/bin/env bash
state=${STUB_STATE:?}
[[ "$*" == */statuses/* ]] || exit 0
while [ $# -gt 0 ]; do [ "$1" = -d ] && body=$2; shift; done
line=$(jq -r '"status \(.context) \(.state)"' <<<"$body")
flock "$state/lock" bash -c 'echo "$1" >>"$2"' _ "$line" "$state/calls"
EOF
chmod +x "$tmp/bin/curl"

# Runs one case: the entry point, started like CI or a terminal starts it, then cancelled once every
# `|`-separated line of `ready` is in the stub's log. Prints how the run ended.
cat >"$tmp/cancel.py" <<'EOF'
import os, signal, subprocess, sys, time
mode, ready, calls, *cmd = sys.argv[1:]
# A case runs as a background job, which starts with SIGINT ignored where bash follows POSIX; a CI
# runner or a terminal starts the entry point with the default.
def default_sigint():
    signal.signal(signal.SIGINT, signal.SIG_DFL)
p = subprocess.Popen(cmd, cwd=os.environ["REPO"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=(mode == "terminal"), preexec_fn=default_sigint)
deadline = time.time() + 60
while time.time() < deadline and p.poll() is None:
    if os.path.exists(calls) and all(r in open(calls).read() for r in ready.split("|")):
        break
    time.sleep(0.1)
else:
    print(f"never got to '{ready}' (exit {p.poll()})"); p.kill(); sys.exit(1)
if mode == "ci":
    for sig, wait in ((signal.SIGINT, 7.5), (signal.SIGTERM, 2.5)):
        p.send_signal(sig)
        try:
            p.wait(wait); print(f"exited on {sig.name}"); break
        except subprocess.TimeoutExpired:
            pass
    else:
        p.kill(); p.wait(); print("needed SIGKILL")
else:
    os.killpg(p.pid, signal.SIGINT)
    time.sleep(0.5)
    try: os.killpg(p.pid, signal.SIGINT)
    except ProcessLookupError: pass
    try:
        p.wait(10); print("exited on Ctrl-C")
    except subprocess.TimeoutExpired:
        p.kill(); p.wait(); print("still running 10s after Ctrl-C")
EOF

# Cases run in parallel, each with its own stub state, and report once all are done.
case_n=0
# check <name> <mode> <ready> <want instances terminated> <want commands cancelled> <entry point...>
function check {
  case_n=$((case_n + 1))
  run_case "$tmp/state$case_n" "$@" >"$tmp/result$case_n" &
}
function run_case {
  local state=$1 name=$2 mode=$3 ready=$4 want_terminated=$5 want_cancelled=$6
  shift 6
  mkdir -p "$state"
  : >"$state/calls"
  local ended
  ended=$(env -i PATH="$tmp/bin:$PATH" HOME="$tmp" REPO="$tmp/repo" STUB_STATE="$state" CI=1 CI_REDIS_AVAILABLE=0 \
    GITHUB_REPOSITORY=test/repo GITHUB_TOKEN=test REF_NAME=test AWS_DEFAULT_REGION=us-east-2 \
    STUB_FLEET_DELAY="${STUB_FLEET_DELAY:-0}" STUB_TERMINATE_DELAY="${STUB_TERMINATE_DELAY:-0}" \
    python3 "$tmp/cancel.py" "$mode" "$ready" "$state/calls" "$@" 2>&1 || true)
  local terminated cancelled
  terminated=$({ grep '^terminated ' "$state/calls" || true; } | cut -d' ' -f2 | sort -u | xargs)
  cancelled=$(grep -c '^cancelled ' "$state/calls" || true)
  # The last status posted for each context: a cancelled run's must not be left pending.
  local statuses
  statuses=$({ grep '^status ' "$state/calls" || true; } | tac | sort -u -k2,2 -s | cut -d' ' -f3 | sort -u | xargs)
  if [ "$terminated" = "$want_terminated" ] && [ "$cancelled" -ge "$want_cancelled" ] && [ "$statuses" = error ] &&
    [[ "$ended" != *SIGKILL* && "$ended" != *"still running"* && "$ended" != *never* ]]; then
    pass "$name ($ended)"
  else
    fail "$name: $ended; terminated '$terminated' (want '$want_terminated'), $cancelled SSM commands cancelled (want $want_cancelled), statuses left '$statuses' (want error); calls: $(xargs <"$state/calls")"
  fi
}

check "CI cancel while the build runs terminates the instance" \
  ci "polling cmd-i-1" "i-1" 1 "$script_dir/bootstrap_ec2" "./bootstrap.sh ci-fast"

STUB_FLEET_DELAY=3 check "CI cancel while the instance is being requested terminates it" \
  ci "requesting fleet" "i-1" 0 "$script_dir/bootstrap_ec2" "./bootstrap.sh ci-fast"

STUB_TERMINATE_DELAY=1 check "Ctrl-C, twice, while the build runs terminates the instance" \
  terminal "polling cmd-i-1" "i-1" 1 "$script_dir/bootstrap_ec2" "./bootstrap.sh ci-fast"

check "CI cancel of a multi-job run terminates every job's instance" \
  ci "polling cmd-i-1|polling cmd-i-2" "i-1 i-2" 2 "$script_dir/bootstrap_ec2_multi" "x-a amd64 ci-fast" "x-b amd64 ci-fast"

STUB_TERMINATE_DELAY=1 check "Ctrl-C, twice, of a multi-job run terminates every job's instance" \
  terminal "polling cmd-i-1|polling cmd-i-2" "i-1 i-2" 2 "$script_dir/bootstrap_ec2_multi" "x-a amd64 ci-fast" "x-b amd64 ci-fast"

wait
for i in $(seq 1 $case_n); do
  line=$(cat "$tmp/result$i")
  echo -e "$line"
  if [[ "$line" == *✓* ]]; then ((++passed)); else ((++failed)); fi
done

# Every run's processes are gone, once their cleanup has had a moment to finish. A run's processes are
# told apart by the STUB_STATE they inherit, as the same scripts may be running for other reasons, such
# as a build that runs these tests.
function leftover {
  local pid
  for pid in $(pgrep -f "$script_dir/(bootstrap_ec2|internal/ssm_send_command|internal/aws_instance_lease|denoise|aws_request_instance)"); do
    tr '\0' '\n' <"/proc/$pid/environ" 2>/dev/null | grep -q "^STUB_STATE=$tmp/" && ps -o pid=,args= -p "$pid" | cut -c1-120
  done
  return 0
}
sleep 1
left=$(leftover)
if [ -n "$left" ]; then
  fail "processes of a cancelled run are left: $(tr '\n' ' ' <<<"$left")"
else
  pass "no process of any run is left"
fi

echo
echo "$passed passed, $failed failed."
[ "$failed" -eq 0 ]
