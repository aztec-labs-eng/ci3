#!/usr/bin/env bash
# internal/otel_log against a local collector that records each request.
set -euo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/../source"

RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
NC=$'\033[0m'
TESTS_PASSED=0
TESTS_FAILED=0
pass() { echo "${GREEN}✓${NC} $1"; ((TESTS_PASSED++)) || true; }
fail() { echo "${RED}✗${NC} $1: $2"; ((TESTS_FAILED++)) || true; }
check() { if [ "$2" == "$3" ]; then pass "$1"; else fail "$1" "expected '$2', got '$3'"; fi; }

dir=$(mktemp -d)
# Answers each POST with the status in $dir/status and saves its headers and body.
cat >"$dir/collector.py" <<'PY'
import http.server, sys, os
d = sys.argv[1]
class H(http.server.BaseHTTPRequestHandler):
    def do_POST(self):
        n = len(os.listdir(d))
        body = self.rfile.read(int(self.headers["Content-Length"]))
        with open(f"{d}/req-{n}", "w") as f:
            f.write(f"{self.path}\n{self.headers['Authorization']}\n{body.decode()}")
        self.send_response(int(open(f"{d}/../status").read()))
        self.end_headers()
    def log_message(self, *a): pass
s = http.server.HTTPServer(("127.0.0.1", 0), H)
print(s.server_port, flush=True)
s.serve_forever()
PY
mkdir "$dir/reqs"
echo 200 >"$dir/status"
python3 "$dir/collector.py" "$dir/reqs" >"$dir/port" &
collector=$!
trap 'kill $collector 2>/dev/null; rm -rf "$dir"' EXIT
while [ ! -s "$dir/port" ]; do sleep 0.1; done

export GITHUB_REPOSITORY=org/repo CI_OTEL_ENDPOINT=http://127.0.0.1:$(cat "$dir/port")/
record='{"event":"ci.instance","instance_s":42}'
reqs() { ls "$dir/reqs" | wc -l; }

echo "=== otel_log ==="

CI_OTEL_TOKEN= CI_OTEL_PROJECT=p otel_log "$record"
check "sends nothing without a token" 0 "$(reqs)"
CI_OTEL_TOKEN=t CI_OTEL_PROJECT= otel_log "$record"
check "sends nothing without a project" 0 "$(reqs)"

CI_OTEL_TOKEN=t0ken CI_OTEL_PROJECT=proj otel_log "$record"
check "sends one request" 1 "$(reqs)"
req=$dir/reqs/req-0
check "posts to /v1/logs" /v1/logs "$(sed -n 1p "$req")"
check "authorizes with the token" "Bearer t0ken" "$(sed -n 2p "$req")"
payload=$(sed -n '3,$p' "$req")
attrs=$(jq -c '.resourceLogs[0].resource.attributes | map({(.key): .value.stringValue}) | add' <<<"$payload")
check "labels the stream" \
  '{"project":"proj","service.name":"ci3","deployment.environment.name":"ci","vcs.repository.name":"org/repo"}' "$attrs"
check "carries the record as the body" "$record" \
  "$(jq -r '.resourceLogs[0].scopeLogs[0].logRecords[0].body.stringValue' <<<"$payload")"

echo 500 >"$dir/status"
err=$(CI_OTEL_TOKEN=t CI_OTEL_PROJECT=p otel_log "$record" 2>&1) && code=0 || code=$?
check "succeeds when the collector fails" 0 "$code"
[[ "$err" == *"answered 500"* ]] && pass "warns when the collector fails" || fail "warns when the collector fails" "$err"

before=$(reqs)
CI_OTEL_TOKEN=t CI_OTEL_PROJECT=p otel_log 'not json' 2>/dev/null && code=0 || code=$?
check "succeeds on a record that is not JSON" 0 "$code"
check "sends nothing for a record that is not JSON" "$before" "$(reqs)"

echo
echo "Passed: $TESTS_PASSED, failed: $TESTS_FAILED"
[ "$TESTS_FAILED" -eq 0 ]
