#!/usr/bin/env bash
# Steps (step, step_legacy, step_plan, step.mk) on a toy repository with a local cache.
#
#   a  step: builds out/a.txt from its source, after c (only order-only prerequisites)
#   c  step: a check (outputs -), which a and b run after (order-only), so not part of their keys
#   l  not a step: a recipe run through step_legacy, keyed by its ./bootstrap.sh hash
#   b  step: uses a's and l's outputs, so both are in its key
#
# Each project's bootstrap.sh logs what it ran to runs.log, which is what the cases check.
set -euo pipefail

ci3="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
tmp=$(mktemp -d)
[ -n "${STEP_TEST_KEEP:-}" ] && echo "keeping $tmp" || trap 'rm -rf "$tmp"' EXIT
passed=0
failed=0
pass() { echo -e "  \033[32m✓ $1\033[0m"; ((++passed)); }
fail() { echo -e "  \033[31m✗ $1\033[0m"; ((++failed)); }
check() { if eval "$2"; then pass "$1"; else fail "$1"; fi; }

# No redis, no S3: an aws with credentials but no S3 access, so the cache is CACHE_LOCAL_DIR alone, and
# step's records go to files.
mkdir -p "$tmp/bin"
printf '%s\n' '#!/usr/bin/env bash' '[ "$1 $2" = "configure export-credentials" ] && exit 0' 'exit 1' >"$tmp/bin/aws"
chmod +x "$tmp/bin/aws"
export PATH="$tmp/bin:$PATH"
export CI=0 CI_REDIS_AVAILABLE=0 DASHBOARD_URL=http://dashboard.invalid DENOISE=0
export S3_FORCE_UPLOAD=1 S3_BUILD_CACHE_AWS_PARAMS="--endpoint-url http://s3.invalid"
export CACHE_LOCAL_DIR="$tmp/cache" CI3_STEP_RECORD_DIR="$tmp/records"
export GITHUB_REPOSITORY=test/repo DEFAULT_BRANCH=main REF_NAME=main
export CI3="$ci3"
unset CI3_KEYS_DIR CI3_KEYS_ONLY CI3_PLAN TARGET_BRANCH

repo="$tmp/repo"
mkdir -p "$repo"/{a,b,c,l}
cd "$repo"
git init -q -b main .
git config user.email t@t
git config user.name t

for p in a b c l; do
  echo "^$p/" >"$p/.rebuild_patterns"
  echo "$p v1" >"$p/src.txt"
done
cat >a/bootstrap.sh <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
echo "a $1" >>"$RUNS"
mkdir -p out && tr a-z A-Z <src.txt >out/a.txt
EOF
cat >b/bootstrap.sh <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
echo "b $1" >>"$RUNS"
mkdir -p out && { cat ../a/out/a.txt ../l/out/l.txt src.txt; echo "STEP_KEY=$STEP_KEY CI3_KEY_A=$CI3_KEY_A CI3_KEY_L=$CI3_KEY_L"; } >out/b.txt
EOF
cat >c/bootstrap.sh <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
echo "c $1" >>"$RUNS"
grep -q v src.txt
EOF
cat >l/bootstrap.sh <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
case "$1" in
  hash) echo "legacy-$(git hash-object src.txt)" ;;
  build) echo "l build" >>"$RUNS"; mkdir -p out && cp src.txt out/l.txt ;;
esac
EOF
chmod +x */bootstrap.sh
printf '%s\n' 'out/' >.gitignore

{
  echo 'SHELL := /bin/bash'
  echo 'ROOT := $(shell git rev-parse --show-toplevel)'
  echo 'include $(CI3)/step.mk'
  echo 'define run_command'
  printf '\t@$(CI3)/step_legacy $(1) $(ROOT)/$(2) "$(3)"\n'
  echo 'endef'
  echo '.PHONY: all a b c l'
  echo 'all: b'
  echo 'a: private INPUTS := a/.rebuild_patterns'
  echo 'a: | c'
  printf '\t$(call step,$@,a,build,out)\n'
  echo 'c: private INPUTS := c/.rebuild_patterns'
  echo 'c:'
  printf '\t$(call step,$@,c,build,-)\n'
  echo 'l:'
  printf "\t\$(call run_command,\$@,l,./bootstrap.sh build)\n"
  echo 'b: private INPUTS := b/.rebuild_patterns'
  echo 'b: a l | c'
  printf '\t$(call step,$@,b,build,out)\n'
} >Makefile
git add -A
git commit -qm init

export RUNS="$tmp/runs.log"
# Runs make from clean outputs, and prints what the bootstrap scripts ran, sorted.
function build {
  rm -rf a/out b/out l/out "$RUNS"
  touch "$RUNS"
  make -s "$@" >"$tmp/make.log" 2>&1 || { cat "$tmp/make.log"; return 1; }
  sort "$RUNS" | paste -sd' ' -
}
function commit {
  echo "$2" >"$1/src.txt"
  git commit -qam "$1: $2"
}

echo "step: building"
check "a cold build runs everything" '[ "$(build)" = "a build b build c build l build" ]'
check "b's command sees its own key and each prerequisite's" \
  'grep -qE "STEP_KEY=[0-9a-f]{16} CI3_KEY_A=[0-9a-f]{16} CI3_KEY_L=legacy-[0-9a-f]{40}$" b/out/b.txt'
check "outputs are cached as <target>-<key>.tar.gz" 'ls "$CACHE_LOCAL_DIR" | grep -qE "^b-[0-9a-f]{16}\.tar\.gz$"'
check "nothing changed: steps are restored, the check is skipped, only the legacy recipe runs" '[ "$(build)" = "l build" ]'
check "a restored step has its outputs" 'grep -q "A V1" b/out/b.txt'
check "a cached check leaves nothing behind in its project" '[ -z "$(git status --porcelain)" ]'

commit c "c v2"
check "a changed check reruns, and b, which only runs after it, is restored" '[ "$(build)" = "c build l build" ]'
commit l "l v2"
check "a changed legacy prerequisite rebuilds b" '[ "$(build)" = "b build l build" ]'
commit a "a v2"
check "a changed step rebuilds itself and what uses it" '[ "$(build)" = "a build b build l build" ]'

echo "step: keys only"
keys=$(mktemp -d)
check "keys-only mode runs nothing" '[ -z "$(CI3_KEYS_ONLY=1 CI3_KEYS_DIR=$keys build)" ]'
check "keys-only mode records every step's key" '[ -s "$keys/a" ] && [ -s "$keys/b" ] && [ -s "$keys/c" ]'
build >/dev/null
check "the keys are the ones a build uses" 'grep -q "STEP_KEY=$(<"$keys/b") " b/out/b.txt'
rm -rf "$keys"

echo "step_plan"
plan=$("$ci3/step_plan" all 2>&1 | sed 's/\x1b\[[0-9;]*m//g' || true)
check "everything built: all cached" 'grep -q "Steps: 0 to build, 3 cached" <<<"$plan"'
commit a "a v3"
: >"$RUNS"
plan=$("$ci3/step_plan" all 2>&1 | sed 's/\x1b\[[0-9;]*m//g' || true)
echo "$plan" | sed 's/^/    /'
check "plan names the input that changed" 'grep -qE "^.*a  [0-9a-f]+  BUILD  changed: a/src.txt" <<<"$plan"'
check "plan says b builds because a changed" 'grep -qE "b  [0-9a-f]+  BUILD  a changed" <<<"$plan"'
check "plan marks the check as running first, cached" 'grep -qE "c \(runs first\)  [0-9a-f]+  cached" <<<"$plan"'
check "plan tells order-only from normal prerequisites when a step has only order-only ones" \
  '[ "$(grep -cE "c \(runs first\)" <<<"$plan")" -eq 2 ]'
check "plan shows the legacy prerequisite as not a step" 'grep -qE "l  +not a step" <<<"$plan"'
check "planning built nothing" '[ ! -s "$RUNS" ]'
rm -f "$CACHE_LOCAL_DIR"/a-*
build >/dev/null
rm -f "$CACHE_LOCAL_DIR"/a-*
plan=$("$ci3/step_plan" all 2>&1 | sed 's/\x1b\[[0-9;]*m//g' || true)
check "plan tells an evicted key from a changed one" 'grep -q "but no longer in the cache" <<<"$plan"'

echo "step: uncommitted changes"
build >/dev/null
echo "a dirty" >a/src.txt
before=$(ls "$CACHE_LOCAL_DIR" | wc -l)
check "a dirty input builds its step and what uses it" '[ "$(build)" = "a build b build l build" ]'
check "and uploads nothing" '[ "$(ls "$CACHE_LOCAL_DIR" | wc -l)" -eq "$before" ]'
plan=$("$ci3/step_plan" all 2>&1 | sed 's/\x1b\[[0-9;]*m//g' || true)
check "plan says the step with changes is uncached" 'grep -qE "a  -  uncached  uncommitted changes to its inputs" <<<"$plan"'
check "and why what uses it is" 'grep -qE "b  -  uncached  a uncached" <<<"$plan"'
git checkout -q a/src.txt

echo
echo "step_test: $passed passed, $failed failed"
[ "$failed" -eq 0 ]
