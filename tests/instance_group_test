#!/usr/bin/env bash
# instance_group (internal/source_stdlib): the Group tag of the instances launched with each instance profile, which
# the launching roles' EC2 and SSM permissions are scoped to.
set -euo pipefail
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/../internal/source_stdlib"

failures=0
for pair in \
  ci3-build-instance-profile:build-instance \
  ci3-release-build-instance-profile:release-build-instance \
  ci3-private-build-instance-profile:private-build-instance \
  ci3-private-release-build-instance-profile:private-release-build-instance; do
  actual=$(instance_group "${pair%%:*}")
  if [ "$actual" == "${pair#*:}" ]; then
    echo "ok: ${pair%%:*}"
  else
    echo "FAIL: ${pair%%:*}: expected ${pair#*:}, got $actual"
    failures=$((failures + 1))
  fi
done

# cache_bucket: with no CI3_CACHE_BUCKET, the cache follows the instance profile, since each profile can
# write only its own trust level's cache. No profile (a local run, a GitHub runner) is the shared cache.
check_bucket() {
  local profile=$1 explicit=$2 expected=$3 actual
  actual=$(CI3_INSTANCE_PROFILE_NAME=$profile CI3_CACHE_BUCKET=$explicit cache_bucket)
  if [ "$actual" == "$expected" ]; then
    echo "ok: cache_bucket profile=${profile:-none} CI3_CACHE_BUCKET=${explicit:-unset}"
  else
    echo "FAIL: cache_bucket profile=${profile:-none} CI3_CACHE_BUCKET=${explicit:-unset}: expected $expected, got $actual"
    failures=$((failures + 1))
  fi
}
check_bucket "" "" aztec-ci-artifacts
check_bucket ci3-build-instance-profile "" aztec-ci-artifacts
check_bucket ci3-release-build-instance-profile "" aztec-ci-release-cache
check_bucket ci3-private-build-instance-profile "" aztec-ci-private-cache
check_bucket ci3-private-release-build-instance-profile "" aztec-ci-private-cache
check_bucket ci3-release-build-instance-profile some-bucket some-bucket

[ $failures -eq 0 ]
