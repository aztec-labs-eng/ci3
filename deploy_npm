#!/usr/bin/env bash
NO_CD=1 source $(dirname "${BASH_SOURCE[0]}")/source

version=$1

dry_run=${DRY_RUN:-0}

npm_tag=$(npm_dist_tag $version)

# Route our scopes at NPM_REGISTRY and authenticate with whatever credential the environment set.
source $ci3/source_npm_auth

package_name=$(jq -r '.name' package.json)

# Create temp directory for publishing
tmpdir=$(mktemp -d)
function cleanup {
  rm -rf "$tmpdir"
}
trap cleanup SIGINT SIGTERM EXIT

# Use npm pack instead of yarn pack. yarn pack fails on portal: dependencies (e.g. bb.js)
# because its beforeWorkspacePacking hook can't resolve workspace:^ for portal links.
# npm pack just packs the files without trying to resolve workspace refs.
npm pack --pack-destination "$tmpdir" --quiet >/dev/null

# Extract and prepare
cd "$tmpdir"
tar -xzf *.tgz
cd package

# Replace workspace:^ with concrete versions.
release_prep_package_json $version

# Pack mode: with NPM_PACK_DIR set, the release build only produces the publishable tarball (the
# same version stamping and workspace rewriting as a publish) and drops it into that directory,
# recording it in the directory's manifest in call order. The bundle is then published elsewhere
# by publish_npm_release, which also decides the dist-tags, so nothing below touches a registry
# and the build machine needs no npm credential.
pack_dir=${NPM_PACK_DIR:-}
if [ -n "$pack_dir" ]; then
  echo_header "packing $package_name"
  mkdir -p "$pack_dir"
  # The pack above already ran the package's prepack scripts inside its workspace; this extracted
  # copy has no workspace, so they must not run again (same reason publish uses --ignore-scripts).
  tgz=$(npm pack --ignore-scripts --pack-destination "$pack_dir" --quiet)
  echo "$tgz" >> "$pack_dir/manifest"
  exit 0
fi

echo_header "publishing $package_name"

published_version=$(npm show . version --tag $npm_tag 2>/dev/null | grep -vE '^@' || true)

# Check if there is already a published package equal to given version, assume this is a re-run of a deploy.
if [ "$version" == "$published_version" ]; then
  echo "Tagged $npm_tag version $version is equal to published $npm_tag version $published_version."
  echo "Skipping publish."
  exit 0
fi

# A version older than what its dist-tag already points at must not take it: publishing a patch to
# an old release line, or re-running an old tag's workflow, would otherwise repoint 'latest' (or
# 'prerelease', or a channel's own tag) backwards for everyone. Such a version is published with no
# dist-tag at all, which costs nothing: an exact version and a range like '@5' both resolve against
# the published versions and consult no tag.
take_tag=1
if [ -n "$published_version" ] && [ "$(semver sort "$published_version" "$version" | tail -1)" != "$version" ]; then
  take_tag=0
  echo "Version $version is older than the published $npm_tag ($published_version);"
  echo "publishing it without moving '$npm_tag'."
fi

# npm attaches a dist-tag to every publish — omitting --tag means 'latest' — so publishing untagged
# means taking one nothing reads and dropping it again. The name is fixed rather than derived from
# the version, so that a tag left behind by an attempt that died between the two steps is cleaned up
# by this package's next publish whatever version that carries. It is also not a bare 'v<major>':
# npm rejects any dist-tag that parses as a semver range, and 'v5' is '>=5.0.0 <6.0.0-0'.
tmp_tag=tmp-publish
if [ "$take_tag" -eq 1 ]; then
  publish_tag=$npm_tag
else
  publish_tag=$tmp_tag
fi

# Called on every path that reaches the registry, so it drops the tag whether this run took it or
# an earlier one died holding it. npm errors when the tag is absent, which is the normal case, so
# ask first — a failure of the removal itself is then still a failure of the release.
function drop_tmp_tag {
  if npm dist-tag ls "$package_name" 2>/dev/null | grep -q "^$tmp_tag:"; then
    npm dist-tag rm "$package_name" "$tmp_tag"
  fi
}

# Publish from temp dir
if [ "$dry_run" -eq 1 ]; then
  denoise "npm publish --ignore-scripts --dry-run --tag $publish_tag --access public"
else
  # Check if version exists.
  if npm view "$package_name@$version" version >/dev/null 2>&1; then
    # Already published, so there is nothing to publish and only a dist-tag to (re)apply.
    if [ "$take_tag" -eq 1 ]; then
      npm dist-tag add $package_name@$version $npm_tag
    else
      echo "$version is already published and older than $npm_tag ($published_version)."
      echo "Leaving '$npm_tag' where it is."
    fi
  else
    # Publish new version.
    denoise "npm publish --ignore-scripts --tag $publish_tag --access public"
  fi
  drop_tmp_tag
fi
