{
	# The admin API can rewrite the config and read the TLS key; nothing here needs it.
	admin off
}

ci.aztec-labs.com {
	encode zstd gzip
	# Long timeouts: the dashboard streams/long-polls live logs.
	reverse_proxy rkapp:8080 {
		transport http {
			read_timeout 3600s
			write_timeout 3600s
		}
	}
}
